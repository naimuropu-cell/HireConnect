generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for local dev. For production (Supabase Postgres) change to:
  // provider = "postgresql"
  // and set DATABASE_URL accordingly. All "String" enum-like fields stay valid on Postgres.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & Auth
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  role          String   @default("SEEKER") // SEEKER | EMPLOYER | ADMIN
  emailVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile        Profile?
  company        Company?
  applications   Application[]
  savedJobs      SavedJob[]
  notifications  Notification[]
  refreshTokens  RefreshToken[]
  otpCodes       OtpCode[]
  reportsMade    Report[]         @relation("reporter")
  reportsResolved Report[]        @relation("resolver")

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id        String    @id @default(cuid())
  userId    String
  code      String
  purpose   String    // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// ---------------------------------------------------------------------------
// Companies & Jobs
// ---------------------------------------------------------------------------

model Company {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  slug        String   @unique
  description String?
  logo        String?
  website     String?
  industry    String?
  size        String? // 1-10, 11-50, ...
  location    String?
  foundedYear Int?
  approved    Boolean  @default(false)
  approvedAt  DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs  Job[]

  @@index([approved])
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  createdAt   DateTime @default(now())

  jobs Job[]
}

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  createdAt   DateTime @default(now())

  profileSkills  ProfileSkill[]
  jobSkills      JobSkill[]
}

model Job {
  id              String     @id @default(cuid())
  companyId       String
  categoryId      String?
  title           String
  slug            String     @unique
  description     String
  type            String     @default("FULL_TIME") // FULL_TIME|PART_TIME|CONTRACT|INTERNSHIP
  workMode        String     @default("ONSITE")    // ONSITE|HYBRID|REMOTE
  location        String?
  salaryMin       Int?
  salaryMax       Int?
  currency        String     @default("USD")
  experienceLevel String     @default("MID") // ENTRY|JUNIOR|MID|SENIOR|LEAD|EXECUTIVE
  vacancies       Int        @default(1)
  deadline        DateTime?
  status          String     @default("OPEN") // OPEN|CLOSED|DRAFT|ARCHIVED
  featured        Boolean    @default(false)
  views           Int        @default(0)
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  requiredSkills JobSkill[]
  applications  Application[]
  savedBy       SavedJob[]

  @@index([status])
  @@index([companyId])
  @@index([categoryId])
  @@index([type, workMode, experienceLevel])
}model JobSkill {
  jobId String
  skillId String

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
}

model ProfileSkill {
  profileId String
  skillId   String
  level     String @default("INTERMEDIATE") // BEGINNER|INTERMEDIATE|ADVANCED|EXPERT

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
}

// ---------------------------------------------------------------------------
// Candidate profile
// ---------------------------------------------------------------------------

model Profile {
  id            String  @id @default(cuid())
  userId        String  @unique
  headline      String?
  about         String?
  location      String?
  phone         String?
  dateOfBirth   DateTime?
  resumeUrl     String?
  resumeName    String?
  portfolio     String?
  github        String?
  linkedin      String?
  languages     String @default("") // comma separated
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills        ProfileSkill[]
  education     Education[]
  experience    Experience[]
  certifications Certification[]

  @@index([userId])
}

model Education {
  id          String   @id @default(cuid())
  profileId   String
  institution String
  degree      String?
  field       String?
  startDate   DateTime?
  endDate     DateTime?
  description String?
  createdAt   DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Experience {
  id          String   @id @default(cuid())
  profileId   String
  company     String
  title       String
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Certification {
  id          String   @id @default(cuid())
  profileId   String
  name        String
  issuer      String?
  url         String?
  issuedDate  DateTime?
  createdAt   DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Applications, saved jobs, interviews
// ---------------------------------------------------------------------------

model Application {
  id          String    @id @default(cuid())
  jobId       String
  userId      String
  status      String    @default("PENDING") // PENDING|VIEWED|SHORTLISTED|INTERVIEW|REJECTED|HIRED|WITHDRAWN
  coverLetter String?
  resumeUrl   String?
  resumeName  String?
  appliedAt   DateTime  @default(now())
  viewedAt    DateTime?
  decidedAt   DateTime?
  notes       String?

  job       Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews Interview[]

  @@unique([jobId, userId])
  @@index([status])
  @@index([userId])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Interview {
  id            String   @id @default(cuid())
  applicationId String
  scheduledAt   DateTime
  durationMin   Int      @default(60)
  mode          String   @default("VIDEO") // ONSITE|VIDEO|PHONE
  link          String?
  location      String?
  notes         String?
  status        String   @default("SCHEDULED") // SCHEDULED|COMPLETED|CANCELLED
  createdBy     String
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Notifications & reports
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // APPLICATION_UPDATE|INTERVIEW|JOB|SYSTEM|ADMIN
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Report {
  id         String    @id @default(cuid())
  reporterId String
  targetType String    // USER | COMPANY | JOB
  targetId   String
  reason     String
  details    String?
  status     String    @default("PENDING") // PENDING|RESOLVED|DISMISSED
  resolvedBy String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  reporter User  @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolver User? @relation("resolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([targetType, targetId])
}
