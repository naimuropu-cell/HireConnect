# Server environment (copy to .env)

# App
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000/api

# Database — SQLite for local dev. For Postgres (Supabase) use:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=file:./dev.db

# Auth
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_COOKIE_NAME=hc_refresh

# Email (Nodemailer). For local dev use Mailtrap/ethereal or set SMTP_DEV=true to log to console.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HireConnect <no-reply@hireconnect.com>"
SMTP_DEV=true

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
